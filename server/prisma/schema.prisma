generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ProductCondition {
  NEW_SEALED
  LIKE_NEW
  OPENED
  NO_BOX
}

enum ProductStatus {
  IN_STOCK
  PRE_ORDER
  OUT_OF_STOCK
  DISCONTINUED
}

enum PreorderStatus {
  OPEN
  CLOSED
  ARRIVED
  COMPLETED
}

enum OrderType {
  NORMAL
  PREORDER
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  DEPOSIT_PAID
  FULLY_PAID
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentTransactionType {
  DEPOSIT
  FULL_PAYMENT
  REMAINING_PAYMENT
  REFUND
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum VoucherType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PointTransactionType {
  EARN
  SPEND
  EXPIRE
  ADMIN_ADJUST
}

enum NotificationType {
  ORDER_UPDATE
  PREORDER_ARRIVED
  PRICE_DROP
  SYSTEM
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String?      @map("password_hash")
  fullName     String       @map("full_name")
  phone        String?
  avatarUrl    String?      @map("avatar_url")
  role         Role         @default(CUSTOMER)
  otakuPoints  Int          @default(0) @map("otaku_points")
  authProvider AuthProvider @default(LOCAL) @map("auth_provider")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  wishlists          Wishlist[]
  cartItems          CartItem[]
  pointTransactions  PointTransaction[]
  notifications      Notification[]
  statusChanges      OrderStatusHistory[] @relation("ChangedByUser")

  @@map("users")
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  recipientName String   @map("recipient_name")
  phone         String
  province      String
  district      String
  ward          String
  streetAddress String   @map("street_address")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Series {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?
  coverImageUrl String?  @map("cover_image_url")
  origin        String?  // Anime, Manga, Game, Light Novel
  releaseYear   Int?     @map("release_year")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  characters SeriesCharacter[]
  products   Product[]

  @@map("series")
}

model Character {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  series   SeriesCharacter[]
  products Product[]

  @@map("characters")
}

model SeriesCharacter {
  seriesId    Int @map("series_id")
  characterId Int @map("character_id")

  series    Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([seriesId, characterId])
  @@map("series_characters")
}

model Manufacturer {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  logoUrl    String?  @map("logo_url")
  country    String   @default("Japan")
  websiteUrl String?  @map("website_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("manufacturers")
}

model Product {
  id                Int              @id @default(autoincrement())
  name              String
  slug              String           @unique
  sku               String           @unique
  description       String?          @db.Text
  price             Decimal          @db.Decimal(12, 2)
  originalPrice     Decimal?         @map("original_price") @db.Decimal(12, 2)
  depositPercentage Decimal?         @default(30) @map("deposit_percentage") @db.Decimal(5, 2)
  stockQuantity     Int              @default(0) @map("stock_quantity")
  soldCount         Int              @default(0) @map("sold_count")
  condition         ProductCondition @default(NEW_SEALED)
  scale             String?          // 1/7, 1/8, Nendoroid, Prize
  material          String?          // PVC, ABS, Resin
  heightCm          Decimal?         @map("height_cm") @db.Decimal(6, 2)
  releaseDate       DateTime?        @map("release_date")
  status            ProductStatus    @default(IN_STOCK)
  isFeatured        Boolean          @default(false) @map("is_featured")
  isActive          Boolean          @default(true) @map("is_active")
  categoryId        Int              @map("category_id")
  seriesId          Int?             @map("series_id")
  characterId       Int?             @map("character_id")
  manufacturerId    Int?             @map("manufacturer_id")
  avgRating         Decimal          @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount       Int              @default(0) @map("review_count")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  category        Category          @relation(fields: [categoryId], references: [id])
  series          Series?           @relation(fields: [seriesId], references: [id])
  character       Character?        @relation(fields: [characterId], references: [id])
  manufacturer    Manufacturer?     @relation(fields: [manufacturerId], references: [id])
  images          ProductImage[]
  preorderBatches PreorderBatch[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlists       Wishlist[]
  cartItems       CartItem[]

  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model PreorderBatch {
  id               Int            @id @default(autoincrement())
  productId        Int            @map("product_id")
  openDate         DateTime       @map("open_date")
  closeDate        DateTime       @map("close_date")
  estimatedArrival DateTime?      @map("estimated_arrival")
  actualArrival    DateTime?      @map("actual_arrival")
  status           PreorderStatus @default(OPEN)
  maxQuantity      Int            @map("max_quantity")
  currentQuantity  Int            @default(0) @map("current_quantity")
  createdAt        DateTime       @default(now()) @map("created_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("preorder_batches")
}

model Order {
  id              Int           @id @default(autoincrement())
  orderCode       String        @unique @map("order_code")
  userId          Int           @map("user_id")
  addressId       Int           @map("address_id")
  type            OrderType     @default(NORMAL)
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingFee     Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  depositPaid     Decimal?      @default(0) @map("deposit_paid") @db.Decimal(12, 2)
  remainingAmount Decimal?      @default(0) @map("remaining_amount") @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(COD) @map("payment_method")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus     OrderStatus   @default(PENDING) @map("order_status")
  voucherId       Int?          @map("voucher_id")
  pointsUsed      Int           @default(0) @map("points_used")
  pointsDiscount  Decimal?      @default(0) @map("points_discount") @db.Decimal(12, 2)
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id])
  address      Address               @relation(fields: [addressId], references: [id])
  voucher      Voucher?              @relation(fields: [voucherId], references: [id])
  items        OrderItem[]
  history      OrderStatusHistory[]
  transactions PaymentTransaction[]
  reviews      Review[]

  @@map("orders")
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  productId       Int      @map("product_id")
  preorderBatchId Int?     @map("preorder_batch_id")
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  preorderBatch PreorderBatch? @relation(fields: [preorderBatchId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int         @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note      String?
  changedBy Int?        @map("changed_by")
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation("ChangedByUser", fields: [changedBy], references: [id])

  @@map("order_status_history")
}

model PaymentTransaction {
  id              Int                      @id @default(autoincrement())
  orderId         Int                      @map("order_id")
  transactionCode String                   @unique @map("transaction_code")
  provider        PaymentMethod
  amount          Decimal                  @db.Decimal(12, 2)
  type            PaymentTransactionType   @default(FULL_PAYMENT)
  status          PaymentTransactionStatus @default(PENDING)
  rawResponse     String?                  @map("raw_response") @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model Voucher {
  id             Int         @id @default(autoincrement())
  code           String      @unique
  type           VoucherType @default(FIXED_AMOUNT)
  value          Decimal     @db.Decimal(12, 2)
  minOrderAmount Decimal     @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?    @map("max_discount") @db.Decimal(12, 2)
  usageLimit     Int?        @map("usage_limit")
  usedCount      Int         @default(0) @map("used_count")
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")

  orders Order[]

  @@map("vouchers")
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  productId  Int      @map("product_id")
  orderId    Int?     @map("order_id")
  rating     Int      // 1 to 5
  comment    String?  @db.Text
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?        @relation(fields: [orderId], references: [id])
  images  ReviewImage[]

  @@map("reviews")
}

model ReviewImage {
  id       Int    @id @default(autoincrement())
  reviewId Int    @map("review_id")
  imageUrl String @map("image_url")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

model Wishlist {
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlists")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model PointTransaction {
  id          Int                  @id @default(autoincrement())
  userId      Int                  @map("user_id")
  orderId     Int?                 @map("order_id")
  type        PointTransactionType
  points      Int
  description String
  createdAt   DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_transactions")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

